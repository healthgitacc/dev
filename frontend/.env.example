# Hospital Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
NEXT_PUBLIC_APP_NAME="Hospital Management System"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Authentication
NEXT_PUBLIC_AUTH_TOKEN_STORAGE_KEY=hospital_auth_token
NEXT_PUBLIC_AUTH_USER_STORAGE_KEY=hospital_auth_user

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Timeouts (in milliseconds)
NEXT_PUBLIC_REQUEST_TIMEOUT=30000
NEXT_PUBLIC_SESSION_TIMEOUT=1800000

# Pagination
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100
