# Production Environment Configuration
# Copy this file to .env and update with your production values

# ========== DATABASE CONFIGURATION ==========
# PostgreSQL connection string for production
DATABASE_URL=postgresql://hospital_admin:your_secure_password_here@prod-db-host.com:5432/hospital_db
USE_SQLITE=false

# Database credentials (used if DATABASE_URL is not set)
DB_USER=hospital_admin
DB_PASSWORD=your_secure_password_here
DB_HOST=prod-db-host.com
DB_PORT=5432
DB_NAME=hospital_db

# ========== SECURITY CONFIGURATION ==========
# Generate a secure SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_generated_secret_key_here_minimum_32_characters

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== API SETTINGS ==========
DEBUG=false
API_TITLE=Hospital Appointment & Medical Record Management
API_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ========== TWILIO SMS CONFIGURATION ==========
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ========== APPOINTMENT REMINDER SETTINGS ==========
REMINDER_ENABLED=true
REMINDER_HOUR=8
REMINDER_MINUTE=0
REMINDER_HOURS_BEFORE=24

# ========== LOGGING CONFIGURATION ==========
# Set to true to log all SQL queries (performance impact)
SQL_ECHO=false

# ========== CORS SETTINGS ==========
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ========== PRODUCTION CHECKLIST ==========
# Before deploying to production:
# [ ] Change all placeholder values above
# [ ] Generate a new SECRET_KEY
# [ ] Use strong DB password
# [ ] Enable HTTPS for frontend
# [ ] Update ALLOWED_ORIGINS with your domain
# [ ] Set DEBUG=false
# [ ] Configure real Twilio credentials
# [ ] Set up database backups
# [ ] Enable monitoring and logging
# [ ] Test SSL certificate for database

